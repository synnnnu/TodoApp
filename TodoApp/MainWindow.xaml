<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid Margin="15">
        <!-- Grid.RowDefinitions: 화면을 위/아래 두 구역으로 나눔
         Auto = 내용물 크기만큼만 차지, * = 남는 공간을 전부 차지 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단: 입력창 + 추가 버튼 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <!-- 할 일을 입력하는 텍스트박스. x:Name으로 이름 붙여서 코드에서 접근 -->
            <TextBox x:Name="TaskInput" Width="250" Height="25"/>

            <!-- 추가 버튼. 클릭하면 AddButton_Click 함수 실행 -->
            <Button Content="추가" 
                Click="AddButton_Click" 
                Width="60" 
                Height="25" 
                Margin="5,0,0,0"/>
        </StackPanel>

        <!-- 하단: 할 일 목록이 표시될 리스트박스 -->
        <ListBox x:Name="TaskListBox" Grid.Row="1"/>
    </Grid>
</Window>
